# ---------------------------------------------------------------------------
# Vibe Control — frontend environment
# Copy to `.env` for local overrides:  cp .env.example .env
# ---------------------------------------------------------------------------

# Leave EMPTY in development — Vite proxies /api and /static to the backend
# (see vite.config.js). Set this only for production builds, to your API origin:
#   VITE_API_URL=https://api.your-domain.com
VITE_API_URL=
